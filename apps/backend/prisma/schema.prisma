generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// IDs reuse the frontend's existing human-readable values ("e1", "NK-101", "c1")
// instead of generated ids — see CLAUDE.md for why.

model Employee {
  id       String @id
  name     String
  role     String
  initials String
  tasks    Task[]
  // Personal sign-in password, set by an admin. "scrypt$<salt>$<hash>", never
  // returned by the API. null means this person cannot sign in on their own.
  passwordHash String?
}

model Task {
  id         String   @id
  title      String
  client     String
  // Free-text values matching the frontend's STATUS_META / PRIORITY_META keys
  // exactly ("todo" | "inprogress" | "done", "low" | "medium" | "high").
  // Kept as String rather than an enum so the API can echo the same literal
  // values the UI already expects, with no hyphen/case remapping layer.
  status     String
  priority   String
  assigneeId String
  assignee   Employee @relation(fields: [assigneeId], references: [id])
  updatedAt  DateTime @updatedAt

  // Optional details from the "new work" form.
  customerPhone      String?
  district           String?
  department         String?
  // Any of "survey" | "x-section" | "drawing" | "design" | "printout", matching
  // the frontend's WORK_TYPES ids.
  workTypes          String[]  @default([])
  details            String?
  // A calendar date with no time: stored as midnight UTC.
  expectedCompletion DateTime?

  // When the task was created through the API, and when it last moved to
  // "done" (cleared if it is moved back). Null on tasks that predate these
  // columns: their real dates are unknown.
  createdAt   DateTime?
  completedAt DateTime?

  // Receivables. fee is the amount to charge for this work in whole rupees:
  // null until the admin sets it, 0 for work that is not charged. Only an
  // admin sees or changes it. lastReminder is when someone last logged a
  // payment reminder call to the customer.
  fee          Int?
  lastReminder DateTime?
  payments     Payment[]
}

// Money received for a piece of work. A ticket's payment status is never
// stored: it is worked out from Task.fee and the payments recorded against it,
// so the Work Board and Receivables cannot disagree.
model Payment {
  id         Int      @id @default(autoincrement())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // Whole rupees, always more than zero.
  amount     Int
  receivedAt DateTime @default(now())
  note       String?

  @@index([taskId])
}

// A message sent from the public landing page. Anyone can create one; only
// signed-in staff can read, update or delete them.
model Enquiry {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  // What the visitor needs, in their words. Optional.
  message   String?
  // "new" | "contacted" | "closed"
  status    String   @default("new")
  createdAt DateTime @default(now())
}

// The activity log: who did what, and when. One row for every change made
// through the API, written in the same transaction as the change, so there is
// never a change without its entry. Rows are only ever added: the API has no
// route that edits or removes them, and a database trigger (see the migration)
// refuses UPDATE, DELETE and TRUNCATE on this table.
model ActivityLog {
  id Int      @id @default(autoincrement())
  // Set by the database, not by the request.
  at DateTime @default(now())

  // Who. actorType is "person" (a personal sign-in; actorId is the employee
  // id), "admin" or "office" (the shared passwords), "public" (the website
  // enquiry form), "unknown" (a failed sign-in) or "open" (sign-in switched
  // off). actorName is the name as it was at the time.
  actorType String
  actorId   String?
  actorName String

  // What: "<type>.<verb>", for example "task.moved" or "payment.recorded".
  action     String
  // The record it was done to. Plain values with no foreign key, so entries
  // outlive the record they describe.
  entityType String
  entityId   String?
  // One readable line, complete without the record ("Moved NK-104 ... ").
  summary    String
  // Field by field: { "<field>": { "from": ..., "to": ... } }. Everything on a
  // new record has from null; everything on a deleted one has to null. Never
  // holds passwords or their hashes.
  changes    Json?

  // Where from.
  ip        String?
  userAgent String?

  @@index([at])
  @@index([actorId, id])
  @@index([entityType, entityId, id])
}
