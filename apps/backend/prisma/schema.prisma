generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// IDs reuse the frontend's existing human-readable values ("e1", "NK-101", "c1")
// instead of generated ids — see CLAUDE.md for why.

model Employee {
  id       String @id
  name     String
  role     String
  initials String
  tasks    Task[]
}

model Task {
  id         String   @id
  title      String
  client     String
  // Free-text values matching the frontend's STATUS_META / PRIORITY_META keys
  // exactly ("todo" | "inprogress" | "done", "low" | "medium" | "high").
  // Kept as String rather than an enum so the API can echo the same literal
  // values the UI already expects, with no hyphen/case remapping layer.
  status     String
  priority   String
  assigneeId String
  assignee   Employee @relation(fields: [assigneeId], references: [id])
  updatedAt  DateTime @updatedAt

  // Optional details from the "new work" form.
  customerPhone      String?
  district           String?
  department         String?
  // Any of "survey" | "x-section" | "drawing" | "design" | "printout", matching
  // the frontend's WORK_TYPES ids.
  workTypes          String[]  @default([])
  details            String?
  // A calendar date with no time: stored as midnight UTC.
  expectedCompletion DateTime?
}

model Client {
  id          String   @id
  name        String
  contact     String
  phone       String
  due         Int
  invoiceDate DateTime
  lastCall    DateTime
  // Matches PAY_STATUS_META keys: "paid" | "due-soon" | "overdue"
  status      String
  notes       String?
  payments    Payment[]
}

// Money received from a client. Recording one lowers Client.due in the same
// transaction, so the payments are the history behind the current balance.
model Payment {
  id         Int      @id @default(autoincrement())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Whole rupees, always more than zero.
  amount     Int
  receivedAt DateTime @default(now())
  note       String?

  @@index([clientId])
}
