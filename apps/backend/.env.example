DATABASE_URL="postgresql://nk:nk@localhost:5432/nk_consultancy"
PORT=4000
# Comma-separated list of allowed frontend origins. Supports * wildcards
# (e.g. https://*.vercel.app for preview deploys). Leave unset to allow all
# origins, which is fine for local dev but should be set in production.
CORS_ORIGINS=http://localhost:5173

# Staff sign-in password. Leave unset locally: the API is then open and no
# sign-in screen is shown. Set it to try the sign-in flow.
# APP_PASSWORD=

# In production (Render) these are set in the dashboard, not in a file:
#   DATABASE_URL  the Neon connection string, ending in ?sslmode=require
#   CORS_ORIGINS  https://nams-project.vercel.app,https://nams-project-*-sahilnarwal2111s-projects.vercel.app
#   APP_PASSWORD  the office password staff sign in with
#   PORT          set by Render itself
